NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Never prefix these with NEXT_PUBLIC_ and never commit real values.
# Use a long, unique passphrase and a separate 32+ character random session secret.
FINALMIX_ACCESS_KEY=
FINALMIX_SESSION_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=finalmix-audio
R2_SIGNED_URL_TTL_SECONDS=600
MODAL_JOB_ENDPOINT=
MODAL_CANCEL_ENDPOINT=
MODAL_WEBHOOK_SECRET=
FINALMIX_ADMIN_EMAILS=

# Application-enforced cost and abuse limits. Provider-side limits are configured separately.
FINALMIX_MAX_UPLOAD_BYTES=157286400
FINALMIX_MAX_SONG_SECONDS=600
FINALMIX_MAX_ACTIVE_JOBS_PER_USER=1
FINALMIX_MAX_DAILY_JOBS_PER_USER=3
FINALMIX_MAX_MONTHLY_GPU_SECONDS_PER_USER=3600
FINALMIX_GLOBAL_PROCESSING_ENABLED=false
